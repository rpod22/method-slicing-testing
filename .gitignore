## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio cache/options directory
.vs/

# VS Code
.vscode/

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config
.nuget/
packages/

# Build logs
msbuild.log
msbuild.err
msbuild.wrn

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Publish output
publish/
*.publishproj.pubxml
*.publishsettings

# Azure
.csx/
*.azurePubxml

# Resharper
*_ReSharper*/
*.DotSettings.user

# dotCover
*.dotCover

# NCrunch
._NCrunch_*
.*,crunchsolution.*
*.ncrunchproject

# StyleCop
StyleCopReport.xml

# Others
*.cache
*.log
*.bak
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Database files
*.mdf
*.ldf

# Local environment files
.env
.env.*

# IIS Express
iisexpress/

# Coverage
coverage/
*.coverage
*.coveragexml

# Generated files
Generated/
*.g.cs
*.g.i.cs

# EF migrations snapshot (optional if auto-generated)
*Migrations/*Designer.cs
*Migrations/*Snapshot.cs